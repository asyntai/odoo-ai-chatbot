<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inject Asyntai chatbot widget on all website pages -->
    <template id="asyntai_chatbot_widget" inherit_id="website.layout" name="Asyntai Chatbot Widget">
        <xpath expr="//head" position="inside">
            <t t-set="asyntai_site_id" t-value="request.env['ir.config_parameter'].sudo().get_param('asyntai_chatbot.site_id', '')"/>
            <t t-set="asyntai_script_url" t-value="request.env['ir.config_parameter'].sudo().get_param('asyntai_chatbot.script_url', 'https://asyntai.com/static/js/chat-widget.js')"/>
            <t t-if="asyntai_site_id">
                <script t-att-src="asyntai_script_url" async="async" defer="defer" t-att-data-asyntai-id="asyntai_site_id"/>
            </t>
        </xpath>
    </template>
</odoo>

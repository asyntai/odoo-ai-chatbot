<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action to open Settings with Asyntai tab -->
    <record id="action_asyntai_settings" model="ir.actions.act_window">
        <field name="name">Asyntai AI Chatbot</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'asyntai_chatbot', 'bin_size': False}</field>
    </record>

    <!-- Root menu item (appears in app switcher) -->
    <menuitem
        id="menu_asyntai_root"
        name="Asyntai AI Chatbot"
        action="action_asyntai_settings"
        web_icon="asyntai_chatbot,static/description/icon.png"
        sequence="100"/>
</odoo>
